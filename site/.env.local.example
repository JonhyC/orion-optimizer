# Copia para .env.local e preenche. .env.local NUNCA vai para controlo de
# versoes - contem o segredo da aplicacao Discord.

# URL onde o site corre. Tem de bater certo com o Redirect URI registado
# no portal do Discord.
APP_URL=http://localhost:3400

# --- Aplicacao Discord -------------------------------------------------
# discord.com/developers/applications -> New Application -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Redirect URI a registar no portal (OAuth2 -> Redirects), exatamente assim:
#   http://localhost:3400/api/auth/discord/callback

# --- Servidor ----------------------------------------------------------
# Definicoes do Discord -> Avancado -> Modo de Programador (ligar).
# Depois: botao direito no servidor -> Copiar ID do Servidor.
DISCORD_GUILD_ID=

# --- Cargos de PERMISSAO -----------------------------------------------
# Definicoes do Servidor -> Cargos -> botao direito em cada um -> Copiar ID.
# O mais alto ganha: alguem com owner E member fica owner.
# Quem nao tiver nenhum destes fica como cliente.
DISCORD_ROLE_OWNER=
DISCORD_ROLE_DEVELOPER=
DISCORD_ROLE_STAFF=
DISCORD_ROLE_MEMBER=

# --- Cargos de PLANO ---------------------------------------------------
# Eixo separado das permissoes: podes ser owner e ter basic ao mesmo tempo.
# Tambem aqui o mais alto ganha.
DISCORD_TIER_ULTIMATE=
DISCORD_TIER_PRO=
DISCORD_TIER_BASIC=

# Os cargos separadores ("--- high roles ---" e afins) nao levam ID nenhum:
# nao fazem nada e podem ser ignorados.

# Exigir pertencer ao servidor para entrar no painel.
# Se puseres false, qualquer pessoa com conta Discord entra como cliente.
DISCORD_REQUIRE_GUILD=true

# --- Pagamentos --------------------------------------------------------
# Stripe Checkout: cartao credito/debito e Apple Pay passam por "card".
# Configura tambem o webhook para:
#   http://localhost:3400/api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal Checkout. Usa sandbox por defeito; define PAYPAL_ENV=live em producao.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- Suporte -----------------------------------------------------------
# Opcao 1: webhook direto do canal de suporte.
DISCORD_SUPPORT_WEBHOOK_URL=
# Opcao 2: canal onde o bot publica os pedidos, usando DISCORD_BOT_TOKEN.
DISCORD_SUPPORT_CHANNEL_ID=

# --- Base de dados -----------------------------------------------------
# Diretorio da base de dados. Por defeito ../data localmente e
# /tmp/orion-data na Vercel.
# ORION_DATA_DIR=
# Compatibilidade com configuracoes antigas que indicam o ficheiro completo:
# ORION_DB_PATH=
