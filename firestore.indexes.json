{
  "indexes": [
    {
      "comment": "Encomendas de um cliente, mais recentes primeiro. O Firestore exige indice composto sempre que se filtra por um campo e ordena por outro.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "user_id", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    },
    {
      "comment": "Receita por periodo: filtra por estado e ordena por data.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    },
    {
      "comment": "Reviews publicadas na pagina inicial.",
      "collectionGroup": "reviews",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "approved", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    },
    {
      "comment": "Planos activos pela ordem em que aparecem na pagina de precos.",
      "collectionGroup": "plans",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "sort_order", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
